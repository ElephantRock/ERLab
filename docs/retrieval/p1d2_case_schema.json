{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elephant-rock-research-lab/p1d2_case_schema_v1",
  "title": "P1D.2 Retrieval Case",
  "description": "Schema for every P1D.2 retrieval case. v1.2 (seed-hardening patch): adds candidate_pool (scored retrieval universe), claim_dimensions (PICO + causal force), failed_dimension per negative (machine-auditable risk labels), and authored_provisional status. Draft; NOT frozen.",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "benchmark_role",
    "task_family",
    "research_domain",
    "query_or_claim",
    "retrieved_unit",
    "source_document_ids",
    "hard_topical_negatives",
    "relevance_judgments",
    "risk_labels",
    "hard_negative_types",
    "annotation_rationale",
    "case_origin",
    "origin_provenance",
    "deidentification_status",
    "case_author_id",
    "review_status",
    "leakage_group_id",
    "query_semantic_fingerprint",
    "positive_unit_fingerprint",
    "candidate_pool",
    "negative_failed_dimensions",
    "case_mode",
    "scoring_profile",
    "expected_positive_count"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "p1d2_case_schema_v1"},
    "case_id": {"type": "string", "pattern": "^(diag|sealed|holdout)_(pd|er|cr|mr|mps|rga)_\\d{3}$"},
    "benchmark_role": {"type": "string", "enum": ["diagnostic", "sealed_product_proxy", "real_project_holdout"]},
    "task_family": {"type": "string", "enum": ["paper_discovery", "evidence_retrieval", "contradiction_retrieval", "method_retrieval", "multi_paper_synthesis", "research_gap_analysis"]},
    "research_domain": {"type": "string", "enum": ["machine_learning", "biomedical", "nlp"]},
    "query_or_claim": {"type": "string", "minLength": 3},
    "retrieved_unit": {"type": "string", "enum": ["paper_or_abstract", "passage"]},
    "source_document_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "positive_passage_ids": {"type": "array", "items": {"type": "string"}},
    "acceptable_alternate_passages": {"type": "array", "items": {"type": "string"}},
    "contradicting_or_qualifying_passages": {"type": "array", "items": {"type": "string"}},
    "hard_topical_negatives": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "agenda_mismatch_negatives": {"type": "array", "items": {"type": "string"}},
    "false_support_negatives": {"type": "array", "items": {"type": "string"}},
    "relevance_judgments": {"type": "array", "items": {"$ref": "https://elephant-rock-research-lab/p1d2_judgment_schema_v1"}, "minItems": 1},
    "risk_labels": {"type": "array", "items": {"type": "string", "enum": ["false_support", "missed_contradiction", "agenda_mismatch", "missed_relevant_evidence", "redundancy", "latency_resource_cost"]}, "minItems": 1},
    "hard_negative_types": {"type": "array", "items": {"type": "string", "enum": ["same_topic_wrong_population", "same_topic_different_agenda", "same_intervention_wrong_outcome", "supportive_language_without_support", "negated_or_qualified_result", "review_vs_primary", "method_application_vs_definition", "multiple_papers_one_lineage", "paraphrase_low_overlap", "exact_identifier_or_acronym_collision"]}, "minItems": 1},
    "annotation_rationale": {"type": "string", "minLength": 10},
    "case_origin": {"type": "string", "enum": ["synthetic_realistic", "synthetic_derived_from_real_structure", "real_project_deidentified", "real_project_unredacted_controlled"]},
    "origin_provenance": {"type": "string", "minLength": 5},
    "real_project_id": {"type": "string"},
    "synthetic_scenario_id": {"type": "string"},
    "deidentification_status": {"type": "string", "enum": ["not_applicable_synthetic", "deidentified", "unredacted_controlled", "pending_deidentification"]},
    "document_version": {"type": "string"},
    "case_author_id": {"type": "string"},
    "review_status": {"type": "string", "enum": ["provisional", "authored_provisional", "dual_reviewed", "adjudicated"], "description": "v1.2 adds authored_provisional: authoring complete (30 cases), judgments still single-pass and non-scoreable, awaiting independent review."},
    "reviewer_a_id": {"type": "string"},
    "reviewer_b_id": {"type": "string"},
    "adjudicator_id": {"type": "string"},
    "policy_outputs_visible_to_reviewers": {"type": "boolean"},
    "reviewers_blinded_to_each_other": {"type": "boolean"},
    "independence_exception": {"type": "string"},
    "leakage_group_id": {"type": "string"},
    "document_family_id": {"type": "string"},
    "query_semantic_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "positive_unit_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "passages": {"type": "object", "additionalProperties": {"$ref": "#/$defs/passage_provenance"}},
    "candidate_pool": {
      "type": "object",
      "description": "v1.2 PATCH. The scored retrieval universe for this case. Defines exactly which units the retrieval system is allowed to return, so precision/false-support metrics are well-defined. Exhaustive: every unit in candidate_unit_ids must receive a judgment.",
      "required": ["pool_id", "retrieval_surface", "candidate_unit_type", "candidate_unit_ids", "pool_fingerprint", "unjudged_unit_policy"],
      "additionalProperties": false,
      "properties": {
        "pool_id": {"type": "string", "description": "Opaque ID; pools may be shared across cases of the same surface (shared task-family corpus) or per-case."},
        "retrieval_surface": {"type": "string", "enum": ["discovery_ranking", "retrieval_ranking"], "description": "Mirrors the P1B ranking surfaces."},
        "candidate_unit_type": {"type": "string", "enum": ["passage", "paper"], "description": "Must match the case retrieved_unit."},
        "candidate_unit_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "description": "Every retrievable unit. Each MUST be judged exactly once. Cross-case distractors belong here."},
        "pool_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$", "description": "SHA-256 over the sorted candidate_unit_ids. Makes pool membership auditable."},
        "unjudged_unit_policy": {"type": "string", "enum": ["exhaustive_no_unjudged", "exclude_unjudged_from_scoring", "treat_unjudged_as_irrelevant"], "description": "How unjudged units are handled. exhaustive_no_unjudged = every unit judged (preferred for synthetic diagnostic)."}
      }
    },
    "claim_dimensions": {
      "type": "object",
      "description": "v1.2 PATCH (per reviewer). For causal/clinical claims, freeze the explicit claim dimensions so that false-support and agenda-mismatch are machine-auditable rather than free-text. Required when task_family is evidence_retrieval or contradiction_retrieval (the causal-claim families).",
      "additionalProperties": false,
      "properties": {
        "population": {"type": "string"},
        "intervention_or_exposure": {"type": "string"},
        "comparison": {"type": "string"},
        "outcome": {"type": "string"},
        "direction_or_polarity": {"type": "string", "enum": ["reduces", "increases", "no_effect", "improves", "worsens", "mixed", "not_applicable"]},
        "causal_vs_associational": {"type": "string", "enum": ["causal_claim", "associational_claim", "descriptive"]},
        "study_design_requirement": {"type": "string", "description": "e.g. 'randomized trial' for a causal claim."},
        "qualifiers": {"type": "string", "description": "Explicit qualifiers/limits on the claim."}
      }
    },
    "negative_failed_dimensions": {
      "type": "array",
      "description": "v1.2 PATCH. For each hard negative, records which claim dimension it fails on. Makes 'risk-shaped' machine-auditable rather than free-text. Each entry maps a unit_id to the failed dimension(s).",
      "items": {
        "type": "object",
        "required": ["unit_id", "failed_dimensions"],
        "additionalProperties": false,
        "properties": {
          "unit_id": {"type": "string"},
          "failed_dimensions": {"type": "array", "items": {"type": "string", "enum": ["population", "intervention_or_exposure", "comparison", "outcome", "direction_or_polarity", "causal_vs_associational", "study_design_requirement", "evidence_lineage", "evidence_granularity", "meaning_or_domain", "qualifiers"]}, "minItems": 1}
        }
      }
    },
    "case_mode": {
      "type": "string",
      "enum": ["positive_present", "no_positive_expected"],
      "description": "v1.3 PATCH (scoring guard). positive_present = conventional ranked-retrieval case with at least one grade-3 positive. no_positive_expected = negative-control case where no passage fully supports the claim (e.g. a genuine research gap); recall/nDCG are NOT computed for these — only false-match and abstention behavior. Prevents no-positive cases from polluting recall denominators."
    },
    "scoring_profile": {
      "type": "string",
      "enum": ["ranked_relevance", "negative_control"],
      "description": "v1.3 PATCH. Must be ranked_relevance when case_mode=positive_present; negative_control when case_mode=no_positive_expected. Drives which metrics apply."
    },
    "expected_positive_count": {
      "type": "integer",
      "minimum": 0,
      "description": "v1.3 PATCH. The number of grade-3 positives the case contains. 0 for no_positive_expected cases (negative controls). Must match the actual count of grade-3 judgments in the case."
    }
  },
  "$defs": {
    "passage_provenance": {
      "type": "object",
      "required": ["document_id", "document_version", "section_id", "passage_id", "passage_locator", "passage_text_hash", "document_content_hash", "source_access_or_license_basis", "evidence_lineage_id"],
      "additionalProperties": false,
      "properties": {
        "document_id": {"type": "string"},
        "document_version": {"type": "string"},
        "section_id": {"type": "string", "enum": ["abstract", "methods", "results", "discussion", "introduction", "conclusion", "full_text"]},
        "passage_id": {"type": "string"},
        "passage_locator": {"type": "string"},
        "passage_text_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "document_content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_access_or_license_basis": {"type": "string"},
        "evidence_lineage_id": {"type": "string"}
      }
    }
  },
  "allOf": [
    {"description": "evidence_retrieval requires retrieved_unit=passage.", "not": {"required": ["task_family", "retrieved_unit"], "properties": {"task_family": {"const": "evidence_retrieval"}, "retrieved_unit": {"const": "paper_or_abstract"}}}},
    {"description": "contradiction_retrieval requires retrieved_unit=passage.", "not": {"required": ["task_family", "retrieved_unit"], "properties": {"task_family": {"const": "contradiction_retrieval"}, "retrieved_unit": {"const": "paper_or_abstract"}}}},
    {"description": "passage_requirement.", "if": {"required": ["retrieved_unit"], "properties": {"retrieved_unit": {"const": "passage"}}}, "then": {"required": ["positive_passage_ids", "passages"]}},
    {"description": "contradiction_requirement.", "if": {"required": ["task_family"], "properties": {"task_family": {"const": "contradiction_retrieval"}}}, "then": {"required": ["contradicting_or_qualifying_passages"]}},
    {"description": "evidence_retrieval exercises false_support.", "if": {"required": ["task_family"], "properties": {"task_family": {"const": "evidence_retrieval"}}}, "then": {"required": ["risk_labels"], "properties": {"risk_labels": {"contains": {"const": "false_support"}}}}},
    {"description": "contradiction_retrieval exercises missed_contradiction.", "if": {"required": ["task_family"], "properties": {"task_family": {"const": "contradiction_retrieval"}}}, "then": {"required": ["risk_labels"], "properties": {"risk_labels": {"contains": {"const": "missed_contradiction"}}}}},
    {"description": "research_gap_analysis exercises agenda_mismatch.", "if": {"required": ["task_family"], "properties": {"task_family": {"const": "research_gap_analysis"}}}, "then": {"required": ["risk_labels"], "properties": {"risk_labels": {"contains": {"const": "agenda_mismatch"}}}}},
    {"description": "multi_paper_synthesis exercises redundancy.", "if": {"required": ["task_family"], "properties": {"task_family": {"const": "multi_paper_synthesis"}}}, "then": {"required": ["risk_labels"], "properties": {"risk_labels": {"contains": {"const": "redundancy"}}}}},
    {"description": "v1.2 PATCH: evidence_retrieval and contradiction_retrieval require claim_dimensions (causal-claim families).", "if": {"required": ["task_family"], "properties": {"task_family": {"enum": ["evidence_retrieval", "contradiction_retrieval"]}}}, "then": {"required": ["claim_dimensions"]}},
    {"description": "real_project_holdout requires real_project_* origin.", "if": {"required": ["benchmark_role"], "properties": {"benchmark_role": {"const": "real_project_holdout"}}}, "then": {"required": ["case_origin", "real_project_id"], "properties": {"case_origin": {"enum": ["real_project_deidentified", "real_project_unredacted_controlled"]}}}},
    {"description": "synthetic requires synthetic_scenario_id.", "if": {"required": ["case_origin"], "properties": {"case_origin": {"enum": ["synthetic_realistic", "synthetic_derived_from_real_structure"]}}}, "then": {"required": ["synthetic_scenario_id"]}},
    {"description": "real_project requires real_project_id.", "if": {"required": ["case_origin"], "properties": {"case_origin": {"enum": ["real_project_deidentified", "real_project_unredacted_controlled"]}}}, "then": {"required": ["real_project_id"]}},
    {"description": "provisional/authored_provisional cannot have reviewers.", "if": {"required": ["review_status"], "properties": {"review_status": {"enum": ["provisional", "authored_provisional"]}}}, "then": {"not": {"required": ["reviewer_a_id", "reviewer_b_id"]}}},
    {"description": "dual_reviewed/adjudicated require both reviewers + blinding.", "if": {"required": ["review_status"], "properties": {"review_status": {"enum": ["dual_reviewed", "adjudicated"]}}}, "then": {"required": ["reviewer_a_id", "reviewer_b_id", "reviewers_blinded_to_each_other"], "properties": {"reviewers_blinded_to_each_other": {"const": true}}}},
    {"description": "sealed roles must not show policy outputs to reviewers.", "if": {"required": ["benchmark_role"], "properties": {"benchmark_role": {"enum": ["sealed_product_proxy", "real_project_holdout"]}}}, "then": {"required": ["policy_outputs_visible_to_reviewers"], "properties": {"policy_outputs_visible_to_reviewers": {"const": false}}}},
    {"description": "v1.2 PATCH: candidate_pool.candidate_unit_type must match retrieved_unit.", "if": {"required": ["candidate_pool"]}, "then": {"properties": {"candidate_pool": {"properties": {"candidate_unit_type": {"enum": ["passage", "paper"]}}}}}},
    {"description": "v1.3 PATCH: case_mode/scoring_profile consistency. positive_present requires ranked_relevance; no_positive_expected requires negative_control.", "if": {"required": ["case_mode"], "properties": {"case_mode": {"const": "positive_present"}}}, "then": {"properties": {"scoring_profile": {"const": "ranked_relevance"}}}},
    {"description": "v1.3 PATCH: no_positive_expected requires negative_control scoring.", "if": {"required": ["case_mode"], "properties": {"case_mode": {"const": "no_positive_expected"}}}, "then": {"properties": {"scoring_profile": {"const": "negative_control"}}}}
  ]
}
