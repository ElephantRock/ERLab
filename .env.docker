# ── Elephant Rock Docker Configuration ──────────────────────────
#
# Copy this file to .env and fill in your values:
#   cp .env.docker .env
#
# All EROCK_ variables from .env.example are supported.
# Only the most common ones are listed below.

# ── LLM Provider (required) ───────────────────────────────────
# At least one provider must be configured for pipeline runs.
# Default provider: anthropic (via z.ai proxy or direct API)

# Option A: Anthropic (via z.ai proxy)
EROCK_DEFAULT_PROVIDER=anthropic
EROCK_ANTHROPIC_API_KEY=your-api-key-here
EROCK_ANTHROPIC_BASE_URL=https://api.anthropic.com
EROCK_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Option B: OpenAI-compatible
# EROCK_DEFAULT_PROVIDER=openai
# EROCK_OPENAI_API_KEY=your-openai-key
# EROCK_OPENAI_MODEL=gpt-4o

# ── Local LLM (optional) ──────────────────────────────────────
# If running LM Studio or Ollama on the host machine:
# EROCK_LMSTUDIO_ENABLED=true
# EROCK_LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
# EROCK_LMSTUDIO_MODEL=qwen3-4b

# ── Search APIs (optional but recommended) ─────────────────────
# EROCK_SEMANTIC_SCHOLAR_API_KEY=your-s2-key
# EROCK_OPENALEX_EMAIL=your-email@example.com

# ── Environment ────────────────────────────────────────────────
EROCK_ENV=production
EROCK_DEBUG=false
EROCK_AUTH_ENABLED=false

# ── JWT (required if AUTH_ENABLED=true) ────────────────────────
# MUST be changed from default in production
# EROCK_JWT_SECRET=change-this-to-a-random-secret

# ── CORS (production) ─────────────────────────────────────────
# Comma-separated origins. Leave empty for same-origin only.
# EROCK_CORS_ORIGINS=http://localhost:3000
