# Docker environment configuration for Elephant Rock Research Lab
# Copy to .env and fill in your values

# Core
EROCK_DEFAULT_PROVIDER=lmstudio
EROCK_ENV=production
EROCK_DEBUG=false

# Database
EROCK_DATABASE_URL=sqlite:///./data/elephant_rock.db

# LLM Providers (fill in your keys)
EROCK_ANTHROPIC_API_KEY=your-key-here
EROCK_OPENAI_API_KEY=your-key-here

# LM Studio
EROCK_LMSTUDIO_ENABLED=true
EROCK_LMSTUDIO_BASE_URL=http://localhost:1234
EROCK_LMSTUDIO_MODEL=qwen/qwen3-4b-2507

# Embeddings
EROCK_EMBEDDING_PROVIDER=lmstudio
EROCK_EMBEDDING_MODEL=text-embedding-bge-m3
EROCK_EMBEDDING_DIMENSION=1024

# Knowledge Base
EROCK_CHROMA_PERSIST_DIR=./data/chroma

# Features
EROCK_GOVERNANCE_ENABLED=true
EROCK_AUTONOMY_ENABLED=false
EROCK_MULTI_AGENT_ENABLED=false

# Literature APIs
EROCK_OPENALEX_EMAIL=your-email@example.com
