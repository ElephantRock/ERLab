# written on Windows); git text normalization broke the link on commit.
# These files must round-trip byte-for-byte on every platform.
evidence/case2b_manifest.json -text
evidence/case2c_manifest.json -text
evidence/case2d_manifest.json -text
evidence/case2_manifest.json -text
evidence/*.sha256 -text
