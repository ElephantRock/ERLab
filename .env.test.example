# E2E Test Configuration Template
# Copy to .env and fill in your values before running e2e tests.

# --- LLM Provider ---
EROCK_DEFAULT_PROVIDER=anthropic
EROCK_ANTHROPIC_API_KEY=sk-ant-...
EROCK_ANTHROPIC_MODEL=claude-sonnet-4-20250514
# EROCK_ANTHROPIC_BASE_URL=https://your-proxy.example.com

# --- Knowledge Base ---
EROCK_DATABASE_URL=sqlite:///./data/test_e2e.db
EROCK_CHROMA_PERSIST_DIR=./data/test_chroma_e2e
EROCK_BM25_PERSIST_DIR=./data/test_bm25_e2e

# --- Disable optional subsystems ---
EROCK_MEMORY_ENABLED=false
EROCK_SELF_IMPROVE_ENABLED=false
EROCK_GOVERNANCE_ENABLED=false
EROCK_BUDGET_ENABLED=false
EROCK_AUTONOMY_ENABLED=false
EROCK_SKILLS_ENABLED=false
EROCK_MULTI_AGENT_ENABLED=false
