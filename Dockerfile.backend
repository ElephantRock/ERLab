# ── Stage 1: Build ───────────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /app

# Install build dependencies from pyproject.toml
COPY pyproject.toml ./
RUN pip install --no-cache-dir --prefix=/install .

# ── Stage 2: Runtime ────────────────────────────────────────────────
FROM python:3.11-slim AS runtime

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy application source
COPY backend/ backend/
COPY alembic/ alembic/
COPY alembic.ini alembic.ini
COPY SKILL.md SKILL.md
COPY SOUL.md SOUL.md

# Create data directory for SQLite (HB-01)
RUN mkdir -p /app/data

# Non-root user for security (A-02)
RUN groupadd -r erock && useradd -r -g erock -d /app erock
RUN chown -R erock:erock /app /app/data
USER erock

EXPOSE 8000

# Health check — uses existing /health endpoint (FLAG-01 fix)
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

# Entrypoint: run migrations then start server
COPY docker-entrypoint.sh /app/docker-entrypoint.sh
USER root
RUN chmod +x /app/docker-entrypoint.sh
USER erock

CMD ["/app/docker-entrypoint.sh"]
