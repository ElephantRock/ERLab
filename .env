# Elephant Rock E2E Test Configuration
# Uses z.ai Anthropic-compatible endpoint

# --- LLM Provider ---
EROCK_DEFAULT_PROVIDER=anthropic
EROCK_ANTHROPIC_API_KEY=REDACTED_API_KEY
EROCK_ANTHROPIC_MODEL=glm-5.1
EROCK_ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic

# --- Knowledge Base ---
EROCK_DATABASE_URL=sqlite:///./data/elephant_rock.db
EROCK_CHROMA_PERSIST_DIR=./data/chroma
EROCK_BM25_PERSIST_DIR=./data/bm25
EROCK_EMBEDDING_PROVIDER=lmstudio
EROCK_EMBEDDING_MODEL=text-embedding-bge-m3
EROCK_EMBEDDING_DIMENSION=1024

# --- Pipeline Defaults ---
EROCK_GENERATION_ROUNDS=1
EROCK_IDEAS_PER_ROUND=2

# --- Disable optional subsystems ---
EROCK_MEMORY_ENABLED=true
EROCK_SELF_IMPROVE_ENABLED=false
EROCK_GOVERNANCE_ENABLED=true
EROCK_BUDGET_ENABLED=false
EROCK_AUTONOMY_ENABLED=false
EROCK_SKILLS_ENABLED=false
EROCK_MULTI_AGENT_ENABLED=false
EROCK_COST_ROUTING_ENABLED=false
EROCK_MODEL_ROUTING_ENABLED=false

# LM Studio Hybrid (local thinking model)
EROCK_LMSTUDIO_ENABLED=true
EROCK_LMSTUDIO_BASE_URL=http://100.64.0.1:1234
EROCK_LMSTUDIO_MODEL=qwen/qwen3-4b-2507
EROCK_THINKING_MODEL=lmstudio
