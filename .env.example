# Elephant Rock Research Platform — Environment Variables
# Copy this to .env and fill in values.
# All values below are placeholders — never commit real credentials.

# ── LLM Provider ──────────────────────────────────────────
EROCK_DEFAULT_PROVIDER=anthropic

# API keys — at least one cloud key required, OR enable LM Studio below
EROCK_OPENAI_API_KEY=your-openai-key-here
EROCK_ANTHROPIC_API_KEY=your-anthropic-key-here
EROCK_GEMINI_API_KEY=your-gemini-key-here

# Anthropic model config
EROCK_ANTHROPIC_BASE_URL=https://api.anthropic.com
EROCK_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI model config
EROCK_OPENAI_MODEL=gpt-4o

# Gemini model config
EROCK_GEMINI_MODEL=gemini-2.0-flash

# ── LM Studio (local hybrid model) ───────────────────────
EROCK_LMSTUDIO_ENABLED=false
EROCK_LMSTUDIO_BASE_URL=http://localhost:1234/v1
EROCK_LMSTUDIO_MODEL=qwen/qwen3-4b-2507
EROCK_LMSTUDIO_CONTEXT_LENGTH=32768
EROCK_LMSTUDIO_AUTO_DOWNLOAD=false
EROCK_LMSTUDIO_DOWNLOAD_TIMEOUT=600

# GPU Hardware
EROCK_GPU_VRAM_MB=12288

# ── Database ──────────────────────────────────────────────
EROCK_DATABASE_URL=sqlite:///./data/elephant_rock.db

# ── Environment ──────────────────────────────────────────
# "development" (default): permissive CORS, debug respected, JWT warnings only
# "production": strict CORS (no wildcard), debug forced off, JWT secret enforced
EROCK_ENV=development

# ── Authentication ────────────────────────────────────────
EROCK_AUTH_ENABLED=false
EROCK_JWT_SECRET=dev-secret-change-in-production

# ── CORS ──────────────────────────────────────────────────
# JSON list of allowed origins, e.g. ["http://localhost:3000","https://example.com"]
EROCK_CORS_ORIGINS=["*"]

# ── Academic Search ──────────────────────────────────────
# Semantic Scholar API key — HIGHLY RECOMMENDED
# Without this, you'll hit rate limits (429 errors) after a few searches
# Get your free key at: https://www.semanticscholar.org/product/api#api-key
EROCK_SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex polite pool email (optional, improves rate limits)
EROCK_OPENALEX_EMAIL=

# PubMed (NCBI E-utilities) — optional API key for higher rate limits
EROCK_PUBMED_API_KEY=
EROCK_PUBMED_ENABLED=true

# CrossRef — enabled by default, no key required (polite pool uses OpenAlex email)
EROCK_CROSSREF_ENABLED=true

# ── Features ──────────────────────────────────────────────
EROCK_EXPERIMENT_ENABLED=false
EROCK_TREE_OF_THOUGHT_ENABLED=false
EROCK_WEBSOCKET_ENABLED=true
