# Elephant Rock Research Platform Configuration
# Copy to .env and fill in your values

# --- LLM Providers ---
EROCK_DEFAULT_PROVIDER=openai
EROCK_OPENAI_API_KEY=sk-...
EROCK_ANTHROPIC_API_KEY=sk-ant-...
EROCK_GEMINI_API_KEY=...
EROCK_OLLAMA_BASE_URL=http://localhost:11434

# --- Academic APIs ---
EROCK_SEMANTIC_SCHOLAR_API_KEY=
EROCK_OPENALEX_EMAIL=

# --- Knowledge Base ---
EROCK_CHROMA_PERSIST_DIR=./data/chroma
EROCK_EMBEDDING_PROVIDER=openai
EROCK_EMBEDDING_MODEL=text-embedding-3-small
EROCK_CHUNK_SIZE=1000
EROCK_CHUNK_OVERLAP=200

# --- Pipeline Defaults ---
EROCK_GENERATION_ROUNDS=2
EROCK_IDEAS_PER_ROUND=3
EROCK_NOVELTY_TOP_K=20

# --- Database ---
EROCK_DATABASE_URL=sqlite:///./data/elephant_rock.db

# --- S1-Parser ---
EROCK_S1_PARSER_MODE=import
EROCK_S1_PARSER_URL=http://localhost:8000
