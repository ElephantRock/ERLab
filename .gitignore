# Environment files — NEVER commit real secrets.
# Only templates (.env.example, .env.docker, .env.test.example) are tracked.
.env
.env.local
.env.production
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.db

# Virtual environments
.venv/
venv/

# Frontend
node_modules/
.next/
frontend/.next/
frontend/node_modules/

