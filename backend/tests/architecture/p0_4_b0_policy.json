{
  "policy_version": "p0_4_b0",
  "description": "Architectural policy for the P0.4B0 handshake-readiness boundary. Consumed by backend/tests/architecture/test_p0_4_b0_seal.py and scripts/verify_p0_4_b0.py. Editing this manifest is a reviewed change — every entry is load-bearing for the architectural seal.",

  "governed_runtime": {
    "module": "backend/pipeline/vector_runtime.py",
    "class": "GovernedVectorRuntime",
    "required_fields": [
      "backend",
      "session_factory",
      "effective_embedding_config",
      "embedding_adapter"
    ],
    "prohibited_fields": [
      "embedding_provider",
      "profile_dict",
      "embedding_profile_id",
      "db_engine"
    ],
    "prohibited_private_adapters": ["_EmbeddingAdapter"]
  },

  "provider_construction": {
    "approved_factory_modules": [
      "backend/pipeline/knowledge/embedding_providers.py",
      "backend/providers/provider_factory.py",
      "backend/pipeline/vector_runtime.py"
    ],
    "embedding_provider_symbols": [
      "OpenAIEmbeddingProvider",
      "GeminiEmbeddingProvider",
      "OllamaEmbeddingProvider",
      "LMStudioEmbeddingProvider",
      "DummyEmbeddingProvider",
      "CachedEmbeddingProvider"
    ],
    "composition_wrapper_symbols": [
      "FallbackEmbeddingProvider"
    ],
    "factory_function": "create_embedding_provider",
    "note": "FallbackEmbeddingProvider and CachedEmbeddingProvider are composition wrappers that combine already-factory-built providers; they are permitted at composition sites (service_registry, vector_runtime) because they do not construct a raw provider from configuration. The raw provider classes (OpenAI/Gemini/Ollama/LMStudio/Dummy) must be constructed only inside the approved factory modules."
  },

  "central_version_constants": {
    "module": "backend/pipeline/vector_contracts.py",
    "constants": [
      "VECTOR_INDEX_V1",
      "VECTOR_INDEX_V2",
      "EMBEDDING_CONTRACT_PRE_CAPABILITY_V0",
      "EMBEDDING_CONTRACT_CAPABILITY_V1",
      "EMBEDDING_PROFILE_V1"
    ],
    "sql_literal_allowlist": [
      {
        "file": "backend/db/models.py",
        "reason": "SQL CHECK constraints are the lowest layer and must not import Python transport constants. String literals here are intentional layering; cross-reference comments required at the site."
      }
    ]
  },

  "canonical_validation": {
    "module": "backend/pipeline/knowledge/embedding_validation.py",
    "owned_symbols": [
      "validate_embedding_vector",
      "validate_document_embeddings",
      "validate_query_embedding",
      "compute_l2_norm",
      "validate_l2_normalization"
    ],
    "governed_adapter_module": "backend/pipeline/governed_embedding_adapter.py",
    "prohibited_inline_check_patterns": [
      "math.isnan",
      "math.isinf",
      "len(vector) != expected",
      "len(vec) != expected"
    ],
    "side_channel_modules": [
      "backend/pipeline/knowledge/graph_embeddings.py",
      "backend/pipeline/tools/tool_index.py",
      "backend/providers/cache/semantic_cache.py"
    ]
  },

  "side_channels": [
    {
      "name": "knowledge_graph",
      "module": "backend/pipeline/knowledge/graph_embeddings.py",
      "runtime_class": "GraphEmbeddingIndex",
      "purpose": "knowledge_graph_entity",
      "requires_purpose_assert": true
    },
    {
      "name": "tool_description",
      "module": "backend/pipeline/tools/tool_index.py",
      "runtime_class": "ToolEmbeddingIndex",
      "purpose": "tool_description",
      "requires_purpose_assert": true
    },
    {
      "name": "llm_cache_key",
      "module": "backend/providers/cache/semantic_cache.py",
      "runtime_class": "SemanticCache",
      "purpose": "llm_cache_key",
      "requires_purpose_assert": false,
      "note": "Cache channel currently accepts an EmbeddingService + optional cache_namespace rather than a SideChannelEmbeddingRuntime. Purpose isolation is enforced at the fingerprint/namespace layer when cache_namespace is supplied. Production wiring of cache_namespace into provider_factory._wrap_cached is a follow-up for the capability ledger phase (P0.4A1+), not a B0 defect."
    }
  ],

  "side_channel_legacy_wiring": {
    "known_legacy_call_sites": [
      {
        "file": "backend/pipeline/orchestrator/service_registry.py",
        "method": "init_cross_refs",
        "constructs": "GraphEmbeddingIndex(persist_dir=..., embedding_service=self.embedding)",
        "feature_flag": "embedding_novelty_enabled",
        "classification": "legacy_bounded",
        "note": "Constructs KG index via legacy constructor with raw EmbeddingService. Feature-flag gated (default False). Migration to SideChannelEmbeddingRuntime requires EffectiveEmbeddingConfiguration + GovernedEmbeddingAdapter, which belong to P0.4A1+. No new legacy call sites may be added; this list is frozen."
      },
      {
        "file": "backend/pipeline/orchestrator/service_registry.py",
        "method": "init_graph_rag",
        "constructs": "GraphEmbeddingIndex(persist_dir=..., embedding_service=self.embedding)",
        "feature_flag": "graph_rag_enabled",
        "classification": "legacy_bounded"
      },
      {
        "file": "backend/pipeline/orchestrator/service_registry.py",
        "method": "init_tool_discovery",
        "constructs": "ToolEmbeddingIndex(persist_dir=..., embedding_service=self.embedding)",
        "feature_flag": "tool_discovery_enabled",
        "classification": "legacy_bounded"
      }
    ],
    "policy": "These three call sites are the only production locations that construct side-channel indices via the legacy constructor path. They pre-date B0.5 and are feature-flag-gated (all default False). They must not propagate to governed (provenance_v1) runs without migration to SideChannelEmbeddingRuntime. The boundary test forbids any NEW production call site outside this frozen list."
  },

  "embedding_purposes": {
    "module": "backend/pipeline/side_channel_embedding.py",
    "literal_type": "EmbeddingPurpose",
    "valid_purposes": [
      "paper",
      "knowledge_graph_entity",
      "tool_description",
      "llm_cache_key"
    ]
  },

  "effective_configuration": {
    "module": "backend/pipeline/knowledge/embedding_configuration.py",
    "resolver_function": "resolve_effective_embedding_configuration",
    "result_dataclass": "EffectiveEmbeddingConfiguration",
    "input_snapshots": [
      "EmbeddingRuntimeSettingsSnapshot",
      "EmbeddingProfileSnapshot",
      "EmbeddingAdapterCapabilitySnapshot"
    ]
  },

  "governed_adapter": {
    "module": "backend/pipeline/governed_embedding_adapter.py",
    "class": "GovernedEmbeddingAdapter",
    "contract_version_constant": "GOVERNED_EMBEDDING_ADAPTER_CONTRACT_VERSION",
    "contract_version_value": "governed_embedding_adapter_v1"
  },

  "prohibited_capability_claims": {
    "symbols": [
      "verified_until"
    ],
    "expected_count_during_b0": 0,
    "note": "These belong to future macro-waves (capability-bound vector cutover). Their presence in executable production code during A1 indicates premature cutover claims. References in documentation, future-constant declarations, or migration files explicitly classified as forward-reserved do not count.",
    "incremental_allowlist": {
      "allowed_from_a1_1": [
        "EmbeddingCapabilityBinding",
        "EmbeddingCapabilityCheck",
        "capability_binding_id",
        "capability_check_id"
      ],
      "allowed_paths": [
        "backend/db/models.py",
        "backend/pipeline/capability/",
        "backend/pipeline/vector_contracts.py",
        "alembic/versions/027_capability_ledger.py",
        "backend/tests/"
      ],
      "note": "EmbeddingCapabilityBinding and EmbeddingCapabilityCheck are legitimate A1 schema. They are allowed ONLY in the exact paths listed above. verified_until and EmbeddingProfileBindingActivation remain prohibited throughout A1 — they belong to the cutover macro-wave."
    }
  },

  "b0_4_seal": {
    "test_module": "backend/tests/test_providers/test_no_llm_embedding_surface.py",
    "chat_provider_modules": [
      "providers/base.py",
      "providers/openai_provider.py",
      "providers/ollama_provider.py",
      "providers/anthropic_provider.py",
      "providers/litellm_provider.py",
      "providers/gemini_provider.py",
      "providers/cache/cached_provider.py",
      "providers/resilience/resilient_provider.py",
      "providers/stage_wrapper.py",
      "providers/stage_context.py",
      "pipeline/gateway/gateway_provider.py"
    ],
    "dedicated_embedding_module_allowlist": [
      "pipeline/knowledge/embedding_providers.py",
      "pipeline/knowledge/embedding_service.py",
      "pipeline/memory/embedding_dedup.py",
      "pipeline/novelty/embedding_scorer.py",
      "pipeline/governed_embedding_adapter.py",
      "pipeline/side_channel_embedding.py",
      "pipeline/knowledge/graph_embeddings.py",
      "pipeline/tools/tool_index.py",
      "providers/cache/semantic_cache.py",
      "pipeline/literature/relevance_filter.py"
    ]
  }
}
